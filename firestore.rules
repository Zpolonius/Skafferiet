rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Looks up the household document to check membership.
    // Counts as one extra Firestore read per operation that uses it.
    function isMember(householdId) {
      return isSignedIn() &&
             request.auth.uid in
               get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function isAdmin(householdId) {
      return isSignedIn() &&
             get(/databases/$(database)/documents/households/$(householdId)).data.admin
               == request.auth.uid;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    // Any signed-in user can read profiles (needed for member name resolution).
    // Only the owner can write their own document.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Households ────────────────────────────────────────────────────────────
    match /households/{householdId} {
      allow read: if isMember(householdId);

      // Creator must include themselves as the first member and as admin.
      allow create: if isSignedIn() &&
                       request.auth.uid in request.resource.data.members &&
                       request.resource.data.admin == request.auth.uid;

      // Existing members can update freely (rename, leave, etc.).
      // Non-members may only add themselves (join via invite code):
      //   – admin and name must be unchanged
      //   – new members array is exactly old array + their own UID
      allow update: if isMember(householdId) ||
                       (isSignedIn() &&
                        request.resource.data.admin == resource.data.admin &&
                        request.resource.data.name  == resource.data.name  &&
                        request.resource.data.members.hasAll(resource.data.members) &&
                        request.resource.data.members.size() == resource.data.members.size() + 1 &&
                        request.auth.uid in request.resource.data.members);

      allow delete: if isAdmin(householdId);

      // ── Grocery list ───────────────────────────────────────────────────────
      match /grocery_list/{itemId} {
        allow read, write: if isMember(householdId);
      }

      // ── Meal plans ─────────────────────────────────────────────────────────
      match /meal_plans/{weekId} {
        allow read, write: if isMember(householdId);
      }
    }

    // ── Recipes ───────────────────────────────────────────────────────────────
    // Global recipes (householdId == null) are readable by all signed-in users.
    // Household recipes are restricted to members.
    match /recipes/{recipeId} {
      allow read: if isSignedIn() && (
        !('householdId' in resource.data) ||
        resource.data.householdId == null ||
        isMember(resource.data.householdId)
      );

      allow create: if isSignedIn() &&
                       request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isMember(resource.data.householdId)
      );

      // Only the original creator may delete a recipe.
      allow delete: if isSignedIn() &&
                       resource.data.createdBy == request.auth.uid;
    }

    // ── Invitations ───────────────────────────────────────────────────────────
    match /invitations/{inviteId} {
      // Recipient or any member of the sending household can read.
      allow read: if isSignedIn() && (
        resource.data.toUserEmail == request.auth.token.email ||
        isMember(resource.data.fromHouseholdId)
      );

      // Household member creates the invitation; must start as 'pending'.
      allow create: if isMember(request.resource.data.fromHouseholdId) &&
                       request.resource.data.status == 'pending';

      // Only the recipient may change the status (to accepted or declined).
      // All other fields must remain unchanged.
      allow update: if isSignedIn() &&
                       resource.data.toUserEmail == request.auth.token.email &&
                       request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }
  }
}
