rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Looks up the household document to check membership.
    function isMember(householdId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/households/$(householdId)) &&
             request.auth.uid in
               get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function isAdmin(householdId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/households/$(householdId)) &&
             get(/databases/$(database)/documents/households/$(householdId)).data.admin
               == request.auth.uid;
    }

    // Helper to get the current user's household ID from their user profile.
    function currentUserHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    // Any signed-in user can read profiles (needed for member name resolution).
    // Only the owner can write their own document.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Households ────────────────────────────────────────────────────────────
    match /households/{householdId} {
      // Optional shopping day: missing, null, or 1 (Monday) … 7 (Sunday).
      function validShoppingWeekday(d) {
        return d.get('shoppingWeekday', null) == null ||
               (d.shoppingWeekday is int &&
                d.shoppingWeekday >= 1 && d.shoppingWeekday <= 7);
      }

      // Direct lookup allowed for signed-in users (to load own household or verify code when joining).
      // Listing/querying across all households is strictly forbidden.
      allow get: if isSignedIn();
      allow list: if false;

      // Creator must include themselves as the first member and as admin.
      allow create: if isSignedIn() &&
                       request.auth.uid in request.resource.data.members &&
                       request.resource.data.admin == request.auth.uid;

      // Existing members can update freely (rename, leave, etc.).
      // Non-members may only add themselves (join via invite code):
      //   – admin and name must be unchanged
      //   – new members array is exactly old array + their own UID
      allow update: if validShoppingWeekday(request.resource.data) && (
                       isMember(householdId) ||
                       (isSignedIn() &&
                        request.resource.data.admin == resource.data.admin &&
                        request.resource.data.name  == resource.data.name  &&
                        request.resource.data.members.hasAll(resource.data.members) &&
                        request.resource.data.members.size() == resource.data.members.size() + 1 &&
                        request.auth.uid in request.resource.data.members));

      allow delete: if isAdmin(householdId);

      // ── Grocery list ───────────────────────────────────────────────────────
      // Strictly isolated: only members of this household can read/write.
      match /grocery_list/{itemId} {
        allow read, write: if isMember(householdId);
      }

      // ── Recurring items (fast genkøb) ─────────────────────────────────────
      // Members only. Every field is validated so a bad client can't store
      // huge strings or dates the app can't read.
      match /recurring_items/{itemId} {
        function optString(d, key, max) {
          return d.get(key, null) == null ||
                 (d.get(key, null) is string && d.get(key, null).size() <= max);
        }

        function validRecurringItem(d) {
          return d.keys().hasOnly(['name', 'quantity', 'unit', 'category',
                                   'imageUrl', 'frequency', 'intervalWeeks',
                                   'dayOfMonth', 'nextDate', 'lastGroceryItemId',
                                   'createdBy', 'createdAt']) &&
                 d.name is string && d.name.size() >= 1 && d.name.size() <= 80 &&
                 d.quantity is string && d.quantity.size() >= 1 && d.quantity.size() <= 10 &&
                 optString(d, 'unit', 20) &&
                 d.category is string && d.category.size() >= 1 && d.category.size() <= 40 &&
                 optString(d, 'imageUrl', 2048) &&
                 optString(d, 'lastGroceryItemId', 200) &&
                 (
                   (d.frequency == 'weekly' &&
                    d.intervalWeeks is int && d.intervalWeeks >= 1 && d.intervalWeeks <= 4 &&
                    d.get('dayOfMonth', null) == null) ||
                   (d.frequency == 'monthly' &&
                    d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 31 &&
                    d.get('intervalWeeks', null) == null)
                 ) &&
                 d.nextDate is string && d.nextDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
                 d.createdBy is string &&
                 d.createdAt is int;
        }

        allow read, delete: if isMember(householdId);

        allow create: if isMember(householdId) &&
                         validRecurringItem(request.resource.data) &&
                         request.resource.data.createdBy == request.auth.uid;

        // createdBy/createdAt are fixed once the item exists.
        allow update: if isMember(householdId) &&
                         validRecurringItem(request.resource.data) &&
                         request.resource.data.createdBy == resource.data.createdBy &&
                         request.resource.data.createdAt == resource.data.createdAt;
      }

      // ── Meal plans ─────────────────────────────────────────────────────────
      // Strictly isolated: only members of this household can read/write.
      match /meal_plans/{weekId} {
        allow read, write: if isMember(householdId);
      }
    }

    // ── Recipes ───────────────────────────────────────────────────────────────
    // Global recipes (householdId == null) are readable by all signed-in users.
    // Household-specific recipes are strictly restricted to members of that household.
    match /recipes/{recipeId} {
      // Optional number field: missing, null, or a number within [0, max].
      function optNumber(d, key, max) {
        return d.get(key, null) == null ||
               (d.get(key, null) is number && d.get(key, null) >= 0 && d.get(key, null) <= max);
      }

      // Nutrition per serving + servings must be sane numbers.
      // (Per-ingredient nutrition sits inside the ingredients list, which rules
      // cannot loop over; the app ignores invalid values there when reading.)
      function validNutrition(d) {
        return optNumber(d, 'calories', 10000) &&
               optNumber(d, 'protein', 1000) &&
               optNumber(d, 'carbs', 1000) &&
               optNumber(d, 'fat', 1000) &&
               (d.get('servings', null) == null ||
                (d.get('servings', null) is int &&
                 d.get('servings', null) >= 1 && d.get('servings', null) <= 100)) &&
               (d.get('nutritionFromIngredients', null) == null ||
                d.get('nutritionFromIngredients', null) is bool);
      }

      allow read: if isSignedIn() && (
        !('householdId' in resource.data) ||
        resource.data.householdId == null ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          resource.data.householdId == currentUserHouseholdId()
        )
      );

      allow create: if isSignedIn() &&
                       validNutrition(request.resource.data) &&
                       request.resource.data.createdBy == request.auth.uid &&
                       (
                         request.resource.data.householdId == null ||
                         (
                           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                           request.resource.data.householdId == currentUserHouseholdId()
                         )
                       );

      allow update: if isSignedIn() && validNutrition(request.resource.data) && (
        resource.data.createdBy == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          resource.data.householdId == currentUserHouseholdId()
        )
      );

      // Only the original creator may delete a recipe.
      allow delete: if isSignedIn() &&
                       resource.data.createdBy == request.auth.uid;
    }

    // ── Invitations ───────────────────────────────────────────────────────────
    match /invitations/{inviteId} {
      // Recipient or any member of the sending household can read.
      allow read: if isSignedIn() && (
        resource.data.toUserEmail == request.auth.token.email ||
        (request.auth.token.email != null && resource.data.toUserEmail == request.auth.token.email.lower()) ||
        isMember(resource.data.fromHouseholdId)
      );

      // Household member creates the invitation; must start as 'pending'.
      allow create: if isMember(request.resource.data.fromHouseholdId) &&
                       request.resource.data.status == 'pending';

      // Only the recipient may change the status (to accepted or declined).
      // All other fields must remain unchanged.
      allow update: if isSignedIn() && (
                       resource.data.toUserEmail == request.auth.token.email ||
                       (request.auth.token.email != null && resource.data.toUserEmail == request.auth.token.email.lower())
                     ) &&
                       request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }
  }
}
